[
    {
        "id": "smartcut",
        "name": "Smart Cut (Recodes ends)",
        "type": "smartcut",
        "ext": "auto"
    },
    {
        "id": "smartcut_mp4",
        "name": "Smart Cut MP4 (Recodes ends)",
        "type": "smartcut",
        "ext": "mp4"
    },
    {
        "id": "keyframes",
        "name": "Fast Keyframe Cut (No recode)",
        "type": "smartcut",
        "mode": "keyframes",
        "ext": "auto"
    },
    {
        "id": "keyframes_mp4",
        "name": "Fast Keyframe Cut MP4 (No recode)",
        "type": "smartcut",
        "mode": "keyframes",
        "ext": "mp4"
    },
    {
        "id": "mp4",
        "name": "MP4 Video (H.264)",
        "type": "ffmpeg",
        "ext": "mp4",
        "args": [
            "-c:v", "libx264",
            "-crf", "18",
            "-preset", "medium",
            "-c:a", "copy"
        ]
    },
    {
        "id": "mp4_720p",
        "name": "MP4 Video (H.264, 720p)",
        "type": "ffmpeg",
        "ext": "mp4",
        "vf": "scale=-2:'min(ih,720)'",
        "args": [
            "-c:v", "libx264",
            "-crf", "18",
            "-preset", "medium",
            "-movflags", "+faststart",
            "-c:a", "copy"
        ]
    },
    {
        "id": "gif",
        "name": "GIF Animation",
        "type": "ffmpeg",
        "ext": "gif",
        "vf": "fps=15,scale=-1:-1,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse",
        "args": [
            "-an"
        ]
    },
    {
        "id": "avif",
        "name": "AVIF Video (SVT-AV1)",
        "type": "ffmpeg",
        "ext": "avif",
        "args": [
            "-c:v", "libsvtav1",
            "-crf", "30",
            "-preset", "6",
            "-an"
        ]
    }
]
